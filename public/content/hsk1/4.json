{"vocab":[{"han":"有","py":"yǒu","pos":"động từ","meaning":"có","example":"你有中国朋友吗？","exampleVi":"Bạn có bạn người Trung Quốc không?"},{"han":"没有","py":"méi yǒu","pos":"động từ","meaning":"không có","example":"我没有工作。","exampleVi":"Tôi không có việc làm."},{"han":"多少","py":"duō shao","pos":"đại từ","meaning":"bao nhiêu","example":"她有多少个学生？","exampleVi":"Cô ấy có bao nhiêu học sinh?"},{"han":"个","py":"gè","pos":"lượng từ","meaning":"cái, chiếc, người (lượng từ chung)","example":"我有两个孩子。","exampleVi":"Tôi có hai đứa con."},{"han":"两","py":"liǎng","pos":"số từ","meaning":"hai (dùng trước lượng từ)","example":"两个学生","exampleVi":"hai học sinh"},{"han":"呢","py":"ne","pos":"trợ từ","meaning":"còn … thì sao?","example":"我有两个哥哥，你呢？","exampleVi":"Tôi có hai anh trai, còn bạn?"},{"han":"家","py":"jiā","pos":"danh từ","meaning":"nhà, gia đình","example":"这是我的家。","exampleVi":"Đây là nhà của tôi."},{"han":"几","py":"jǐ","pos":"đại từ","meaning":"mấy","example":"你家有几口人？","exampleVi":"Nhà bạn có mấy người?"},{"han":"口","py":"kǒu","pos":"lượng từ","meaning":"(lượng từ đếm người trong nhà)","example":"我家有三口人。","exampleVi":"Nhà tôi có ba người."},{"han":"爸爸","py":"bà ba","pos":"danh từ","meaning":"bố","example":"这是我爸爸。","exampleVi":"Đây là bố tôi."},{"han":"妈妈","py":"mā ma","pos":"danh từ","meaning":"mẹ","example":"我妈妈是老师。","exampleVi":"Mẹ tôi là giáo viên."},{"han":"哥哥","py":"gē ge","pos":"danh từ","meaning":"anh trai","example":"你有哥哥吗？","exampleVi":"Bạn có anh trai không?"},{"han":"弟弟","py":"dì di","pos":"danh từ","meaning":"em trai","example":"我有一个弟弟。","exampleVi":"Tôi có một em trai."},{"han":"妹妹","py":"mèi mei","pos":"danh từ","meaning":"em gái","example":"她没有妹妹。","exampleVi":"Cô ấy không có em gái."},{"han":"儿子","py":"ér zi","pos":"danh từ","meaning":"con trai","example":"这是您儿子吗？","exampleVi":"Đây là con trai của ông/bà phải không?"},{"han":"女儿","py":"nǚ ér","pos":"danh từ","meaning":"con gái","example":"您女儿多大？","exampleVi":"Con gái ông/bà bao nhiêu tuổi?"},{"han":"孩子","py":"hái zi","pos":"danh từ","meaning":"con, trẻ con","example":"他们有两个孩子。","exampleVi":"Họ có hai đứa con."},{"han":"和","py":"hé","pos":"liên từ","meaning":"và","example":"爸爸和妈妈","exampleVi":"bố và mẹ"},{"han":"岁","py":"suì","pos":"lượng từ","meaning":"tuổi","example":"他今年五岁。","exampleVi":"Năm nay cậu bé 5 tuổi."},{"han":"今年","py":"jīn nián","pos":"danh từ","meaning":"năm nay","example":"你今年多大？","exampleVi":"Năm nay bạn bao nhiêu tuổi?"},{"han":"多","py":"duō","pos":"đại từ","meaning":"bao (nhiêu), đến mức nào","example":"你多大？","exampleVi":"Bạn bao nhiêu tuổi?"},{"han":"大","py":"dà","pos":"tính từ","meaning":"lớn (tuổi)","example":"王老师多大？","exampleVi":"Thầy Vương bao nhiêu tuổi?"}],"grammar":[{"title":"有 và 没有","desc":["有 nghĩa là \"có\". Phủ định của 有 là 没有, không dùng 不有."],"formula":"A + 有 / 没有 + B","examples":[{"han":"我有两个哥哥。","vi":"Tôi có hai anh trai."},{"han":"我没有姐姐。","vi":"Tôi không có chị gái."}]},{"title":"Số đếm 0–99 và 两","desc":["11–19: 十 + số (十二); chục: số + 十 (二十); 21–99: số + 十 + số (二十四). Trước lượng từ, \"hai\" dùng 两 chứ không dùng 二."],"formula":"两 + 个 + Danh từ","examples":[{"han":"她有二十四个学生。","vi":"Cô ấy có 24 học sinh."},{"han":"我有两个孩子。","vi":"Tôi có hai đứa con."}]},{"title":"Hỏi số lượng: 几 và 多少","desc":["几 dùng khi đoán số lượng nhỏ (thường dưới 10), phải có lượng từ. 多少 dùng cho số lượng bất kỳ, có thể bỏ lượng từ."],"formula":"几 + Lượng từ + Danh từ · 多少 + (Lượng từ) + Danh từ","examples":[{"han":"你家有几口人？","vi":"Nhà bạn có mấy người?"},{"han":"她有多少个学生？","vi":"Cô ấy có bao nhiêu học sinh?"}]},{"title":"Trợ từ 呢: hỏi lại","desc":["Sau khi nói về mình, dùng \"你呢？\" để hỏi lại người kia cùng nội dung đó."],"formula":"Câu trần thuật，Danh từ / Đại từ + 呢？","examples":[{"han":"我叫白家月，你呢？","vi":"Tôi tên là Bạch Gia Nguyệt, còn bạn?"},{"han":"我是中国人，你呢？","vi":"Tôi là người Trung Quốc, còn bạn?"}]},{"title":"Hỏi tuổi: 几岁 / 多大","desc":["Hỏi trẻ em (dưới 10 tuổi): 几岁？ Hỏi người lớn hoặc bạn bè: 多大？ Với người lớn tuổi hơn nên hỏi lịch sự."],"formula":"你几岁？ · 你多大？","examples":[{"han":"您儿子几岁？","vi":"Con trai ông/bà mấy tuổi?"},{"han":"你今年多大？","vi":"Năm nay bạn bao nhiêu tuổi?"}]}],"texts":[{"title":"Bài khóa 1","lines":[{"who":"李文","han":"王老师，您有多少个学生？","vi":"Thầy Vương, thầy có bao nhiêu học sinh?"},{"who":"王一飞","han":"我有二十个学生。","vi":"Thầy có hai mươi học sinh."},{"who":"李文","han":"他们都是中国人吗？","vi":"Họ đều là người Trung Quốc ạ?"},{"who":"王一飞","han":"不是，他们是法国人和泰国人。","vi":"Không, họ là người Pháp và người Thái Lan."}]},{"title":"Bài khóa 2","lines":[{"who":"王一雪","han":"你家有几口人？","vi":"Nhà em có mấy người?"},{"who":"杨同乐","han":"我家有四口人，爸爸、妈妈、妹妹和我。","vi":"Nhà em có bốn người: bố, mẹ, em gái và em."},{"who":"王一雪","han":"你有哥哥吗？","vi":"Em có anh trai không?"},{"who":"杨同乐","han":"我没有哥哥。","vi":"Em không có anh trai."}]},{"title":"Bài khóa 3","lines":[{"who":"杨同乐","han":"这是您儿子吗？","vi":"Đây là con trai chị ạ?"},{"who":"王一雪","han":"是的。我有两个孩子，一个儿子，一个女儿。","vi":"Đúng vậy. Chị có hai đứa con, một trai, một gái."},{"who":"杨同乐","han":"您儿子几岁？","vi":"Con trai chị mấy tuổi ạ?"},{"who":"王一雪","han":"他今年五岁。","vi":"Năm nay cháu 5 tuổi."},{"who":"杨同乐","han":"您女儿多大？","vi":"Con gái chị bao nhiêu tuổi ạ?"},{"who":"王一雪","han":"她今年十二。","vi":"Năm nay cháu 12."}]}],"id":4,"title":"我有两个孩子","py":"Wǒ yǒu liǎng ge hái zi","vi":"Tôi có hai đứa con","goal":"Nói về gia đình, số lượng và tuổi tác; dùng 有/没有, số đếm 0–99, 两, 几/多少, 呢, 多大.","decks":["bai-04"],"practice":{"choice":[{"q":"我有___个哥哥。","options":["多","二","两","几"],"answer":2,"vi":"Tôi có hai anh trai."},{"q":"你家有几___人？","options":["呢","岁","和","口"],"answer":3,"vi":"Nhà bạn có mấy người?"},{"q":"我___姐姐。","options":["和","呢","没有","不"],"answer":2,"vi":"Tôi không có chị gái."},{"q":"我叫白家月，你___？","options":["吗","和","几","呢"],"answer":3,"vi":"Tôi tên là Bạch Gia Nguyệt, còn bạn?"},{"q":"我家有三口人，爸爸、妈妈___我。","options":["有","也","和","呢"],"answer":2,"vi":"Nhà tôi có ba người: bố, mẹ và tôi."},{"q":"她有___个学生？","options":["和","多少","呢","没有"],"answer":1,"vi":"Cô ấy có bao nhiêu học sinh?"},{"q":"您女儿___大？","options":["呢","多","几","和"],"answer":1,"vi":"Con gái của ông/bà bao nhiêu tuổi?"},{"q":"他今年五___。","options":["岁","口","个","呢"],"answer":0,"vi":"Năm nay cậu bé 5 tuổi."},{"q":"他们有一个___和一个女儿。","options":["爸爸","妈妈","儿子","哥哥"],"answer":2,"vi":"Họ có một con trai và một con gái."},{"q":"这是谁的___？","options":["家","岁","口","多少"],"answer":0,"vi":"Đây là nhà của ai?"},{"q":"你有___吗？","options":["口","岁","多少","弟弟"],"answer":3,"vi":"Bạn có em trai không?"},{"q":"___好，我叫张心华。","options":["口","大家","多少","几"],"answer":1,"vi":"Chào mọi người, tôi tên là Trương Tâm Hoa."},{"q":"我___二十岁，你呢？","options":["今年","口","多少","个"],"answer":0,"vi":"Năm nay tôi 20 tuổi, còn bạn?"},{"q":"王老师有二十___学生。","options":["个","和","岁","口"],"answer":0,"vi":"Thầy Vương có 20 học sinh."},{"q":"她没有___。","options":["岁","多","孩子","口"],"answer":2,"vi":"Cô ấy không có con."}],"order":[{"words":["我","个","有","两","哥哥"],"answer":["我","有","两","个","哥哥"],"end":"。","vi":"Tôi có hai anh trai."},{"words":["没有","姐姐","我"],"answer":["我","没有","姐姐"],"end":"。","vi":"Tôi không có chị gái."},{"words":["人","家","和","有","三","爸爸","妈妈","我","我","口"],"answer":["我","家","有","三","口","人","爸爸","妈妈","和","我"],"end":"，、。","vi":"Nhà tôi có ba người: bố, mẹ và tôi."},{"words":["女儿","大","您","多"],"answer":["您","女儿","多","大"],"end":"？","vi":"Con gái của ông/bà bao nhiêu tuổi?"},{"words":["儿子","个","他们","一","个","和","女儿","一","有"],"answer":["他们","有","一","个","儿子","和","一","个","女儿"],"end":"。","vi":"Họ có một con trai và một con gái."},{"words":["弟弟","你","吗","有"],"answer":["你","有","弟弟","吗"],"end":"？","vi":"Bạn có em trai không?"},{"words":["你","呢","岁","二十","今年","我"],"answer":["我","今年","二十","岁","你","呢"],"end":"，？","vi":"Năm nay tôi 20 tuổi, còn bạn?"},{"words":["孩子","没有","她"],"answer":["她","没有","孩子"],"end":"。","vi":"Cô ấy không có con."},{"words":["你","哥哥","吗","有"],"answer":["你","有","哥哥","吗"],"end":"？","vi":"Bạn có anh trai không?"},{"words":["家","口","几","有","人","你"],"answer":["你","家","有","几","口","人"],"end":"？","vi":"Nhà bạn có mấy người?"},{"words":["爸爸","和","是","这","妈妈","我"],"answer":["这","是","我","爸爸","和","妈妈"],"end":"。","vi":"Đây là bố và mẹ tôi."},{"words":["岁","今年","她","十二"],"answer":["她","今年","十二","岁"],"end":"。","vi":"Năm nay cô bé 12 tuổi."},{"words":["是","呢","人","中国","我","你"],"answer":["我","是","中国","人","你","呢"],"end":"，？","vi":"Tôi là người Trung Quốc, còn bạn?"},{"words":["大","老师","王","今年","多"],"answer":["王","老师","今年","多","大"],"end":"？","vi":"Thầy Vương năm nay bao nhiêu tuổi?"},{"words":["有","他们","人","家","口","五"],"answer":["他们","家","有","五","口","人"],"end":"。","vi":"Nhà họ có năm người."}],"fill":[{"q":"我家有四___人。","answer":"口","hint":"Nhà tôi có bốn người."},{"q":"你___哥哥吗？","answer":"有","hint":"Bạn có anh trai không?"},{"q":"我有___个孩子。","answer":"两","hint":"Tôi có hai đứa con."},{"q":"你___有几口人？","answer":"家","hint":"Nhà bạn có mấy người?"},{"q":"他___妹妹。","answer":"没有","hint":"Anh ấy không có em gái."},{"q":"这是我爸爸___妈妈。","answer":"和","hint":"Đây là bố và mẹ tôi."},{"q":"您___几岁？","answer":"儿子","hint":"Con trai của ông/bà mấy tuổi?"},{"q":"她今年十二___。","answer":"岁","hint":"Năm nay cô bé 12 tuổi."},{"q":"我有一个___。","answer":"女儿","hint":"Tôi có một con gái."},{"q":"我是中国人，你___？","answer":"呢","hint":"Tôi là người Trung Quốc, còn bạn?"},{"q":"你有___个中国朋友？","answer":"多少","hint":"Bạn có bao nhiêu người bạn Trung Quốc?"},{"q":"王老师今年多___？","answer":"大","hint":"Thầy Vương năm nay bao nhiêu tuổi?"},{"q":"我有一个___。","answer":"妹妹","hint":"Tôi có một em gái."},{"q":"他们家有___口人。","answer":"五","hint":"Nhà họ có năm người."},{"q":"这是我的___。","answer":"家","hint":"Đây là nhà của tôi."}]}}