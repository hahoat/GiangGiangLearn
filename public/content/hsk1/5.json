{"vocab":[{"han":"今天","py":"jīn tiān","pos":"danh từ","meaning":"hôm nay","example":"今天我休息。","exampleVi":"Hôm nay tôi nghỉ."},{"han":"号","py":"hào","pos":"danh từ","meaning":"ngày (trong tháng, văn nói)","example":"今天九月八号。","exampleVi":"Hôm nay là ngày 8 tháng 9."},{"han":"日","py":"rì","pos":"danh từ","meaning":"ngày (văn viết)","example":"五月十六日","exampleVi":"ngày 16 tháng 5"},{"han":"月","py":"yuè","pos":"danh từ","meaning":"tháng","example":"今天几月几号？","exampleVi":"Hôm nay là ngày mấy tháng mấy?"},{"han":"星期","py":"xīng qī","pos":"danh từ","meaning":"tuần; thứ","example":"今天星期几？","exampleVi":"Hôm nay thứ mấy?"},{"han":"星期日","py":"xīng qī rì","pos":"danh từ","meaning":"Chủ nhật","example":"星期日我休息。","exampleVi":"Chủ nhật tôi nghỉ."},{"han":"星期天","py":"xīng qī tiān","pos":"danh từ","meaning":"Chủ nhật","example":"星期天我也做饭。","exampleVi":"Chủ nhật tôi cũng nấu cơm."},{"han":"休息","py":"xiū xi","pos":"động từ","meaning":"nghỉ ngơi","example":"星期一你休息吗？","exampleVi":"Thứ Hai bạn có nghỉ không?"},{"han":"会","py":"huì","pos":"động từ năng nguyện","meaning":"biết (làm gì đó)","example":"他会做饭。","exampleVi":"Anh ấy biết nấu cơm."},{"han":"做饭","py":"zuò fàn","pos":"động từ","meaning":"nấu cơm","example":"你会做饭吗？","exampleVi":"Bạn biết nấu cơm không?"},{"han":"做","py":"zuò","pos":"động từ","meaning":"làm, nấu","example":"我会做饺子。","exampleVi":"Tôi biết làm sủi cảo."},{"han":"面条儿","py":"miàn tiáor","pos":"danh từ","meaning":"mì sợi","example":"我会做面条儿。","exampleVi":"Tôi biết nấu mì."},{"han":"饺子","py":"jiǎo zi","pos":"danh từ","meaning":"sủi cảo","example":"我喜欢吃饺子。","exampleVi":"Tôi thích ăn sủi cảo."},{"han":"一些","py":"yì xiē","pos":"số lượng từ","meaning":"một số, một ít","example":"我会做一些菜。","exampleVi":"Tôi biết nấu một số món."},{"han":"菜","py":"cài","pos":"danh từ","meaning":"món ăn","example":"你会做中国菜吗？","exampleVi":"Bạn biết nấu món Trung Quốc không?"},{"han":"下班","py":"xià bān","pos":"động từ","meaning":"tan làm","example":"同乐，下班吗？","exampleVi":"Đồng Lạc, tan làm chưa?"},{"han":"新","py":"xīn","pos":"tính từ","meaning":"mới","example":"这是我的新电脑。","exampleVi":"Đây là máy tính mới của tôi."},{"han":"电脑","py":"diàn nǎo","pos":"danh từ","meaning":"máy tính","example":"你有新电脑吗？","exampleVi":"Bạn có máy tính mới không?"},{"han":"真","py":"zhēn","pos":"phó từ","meaning":"thật, thật là","example":"这个电脑真好看。","exampleVi":"Cái máy tính này thật đẹp."},{"han":"好看","py":"hǎo kàn","pos":"tính từ","meaning":"đẹp, ưa nhìn","example":"真好看！","exampleVi":"Thật đẹp!"},{"han":"喜欢","py":"xǐ huan","pos":"động từ","meaning":"thích","example":"我喜欢中文。","exampleVi":"Tôi thích tiếng Trung."},{"han":"它","py":"tā","pos":"đại từ","meaning":"nó (chỉ vật, con vật)","example":"我也很喜欢它。","exampleVi":"Tôi cũng rất thích nó."}],"grammar":[{"title":"Cách nói ngày tháng","desc":["Tiếng Trung nói thời gian từ lớn đến nhỏ: năm → tháng → ngày → thứ. Năm đọc từng chữ số. Văn nói dùng 号, văn viết dùng 日."],"formula":"… 年 … 月 … 号 / 日，星期 …","examples":[{"han":"今天九月八号。","vi":"Hôm nay là ngày 8 tháng 9."},{"han":"二零二五年五月十六号，星期五。","vi":"Thứ Sáu, ngày 16 tháng 5 năm 2025."}]},{"title":"Hỏi ngày và thứ","desc":["Thứ Hai đến thứ Bảy: 星期 + 一 … 六. Chủ nhật: 星期日 hoặc 星期天 (không nói 星期七)."],"formula":"今天几月几号？ · 今天星期几？","examples":[{"han":"今天几月几号？","vi":"Hôm nay ngày mấy tháng mấy?"},{"han":"今天星期三。","vi":"Hôm nay thứ Tư."}]},{"title":"Động từ năng nguyện 会","desc":["会 + động từ: biết làm việc gì đó (kỹ năng có được nhờ học). Phủ định: 不会."],"formula":"Chủ ngữ + 会 / 不会 + Động từ","examples":[{"han":"他会做饭。","vi":"Anh ấy biết nấu cơm."},{"han":"她不会做饭。","vi":"Cô ấy không biết nấu cơm."}]},{"title":"Cảm thán với 真","desc":["真 + tính từ dùng để cảm thán, khen ngợi: \"thật là …!\"."],"formula":"真 + Tính từ","examples":[{"han":"这个电脑真好看！","vi":"Cái máy tính này thật đẹp!"},{"han":"真好！","vi":"Thật tốt!"}]},{"title":"Âm cuốn lưỡi 儿化","desc":["Một số từ thêm 儿 ở cuối, 儿 không đọc thành âm riêng mà cuốn lưỡi vào âm trước (ghi -r)."],"formula":"… + 儿 → …r","examples":[{"han":"面条儿","vi":"mì sợi (miàntiáor)"},{"han":"好玩儿","vi":"vui (hǎowánr)"}]}],"texts":[{"title":"Bài khóa 1","lines":[{"who":"刘明","han":"今天几号？","vi":"Hôm nay ngày bao nhiêu?"},{"who":"王一雪","han":"今天九月八号。","vi":"Hôm nay ngày 8 tháng 9."},{"who":"刘明","han":"星期几？","vi":"Thứ mấy?"},{"who":"王一雪","han":"星期日。今天我休息。","vi":"Chủ nhật. Hôm nay em nghỉ."}]},{"title":"Bài khóa 2","lines":[{"who":"王一雪","han":"你会做饭吗？","vi":"Em biết nấu cơm không?"},{"who":"杨同乐","han":"我会做。","vi":"Em biết nấu."},{"who":"王一雪","han":"你会做什么？","vi":"Em biết nấu món gì?"},{"who":"杨同乐","han":"我会做面条儿、饺子，也会做一些菜。星期天我也做饭。","vi":"Em biết nấu mì, sủi cảo, còn biết nấu vài món nữa. Chủ nhật em cũng nấu cơm."}]},{"title":"Bài khóa 3","lines":[{"who":"王一雪","han":"同乐，下班吗？","vi":"Đồng Lạc, tan làm chưa?"},{"who":"杨同乐","han":"下班。","vi":"Tan làm rồi ạ."},{"who":"王一雪","han":"这是你的新电脑吗？","vi":"Đây là máy tính mới của em à?"},{"who":"杨同乐","han":"是的，是我的新电脑。","vi":"Vâng, là máy tính mới của em."},{"who":"王一雪","han":"真好看！","vi":"Đẹp thật!"},{"who":"杨同乐","han":"我也很喜欢它。","vi":"Em cũng rất thích nó."}]}],"id":5,"title":"今天我休息","py":"Jīn tiān wǒ xiū xi","vi":"Hôm nay tôi nghỉ","goal":"Nói ngày, tháng, thứ; nói mình biết làm gì với 会; khen ngợi với 真; nói về sở thích với 喜欢.","decks":["bai-05"],"practice":{"choice":[{"q":"今天几___几号？","options":["星期","岁","月","口"],"answer":2,"vi":"Hôm nay ngày bao nhiêu tháng mấy?"},{"q":"今天___几？","options":["岁","星期","月","号"],"answer":1,"vi":"Hôm nay thứ mấy?"},{"q":"今天我___。","options":["真","一些","休息","新"],"answer":2,"vi":"Hôm nay tôi nghỉ."},{"q":"他___做饭。","options":["会","真","新","一些"],"answer":0,"vi":"Anh ấy biết nấu cơm."},{"q":"我会做面条儿和___。","options":["星期","电脑","休息","饺子"],"answer":3,"vi":"Tôi biết nấu mì và sủi cảo."},{"q":"你会做中国___吗？","options":["菜","号","电脑","星期"],"answer":0,"vi":"Bạn biết nấu món Trung Quốc không?"},{"q":"我也会做___菜。","options":["多","两","几","一些"],"answer":3,"vi":"Tôi cũng biết nấu một số món."},{"q":"___我也做饭。","options":["真","好看","新","星期天"],"answer":3,"vi":"Chủ nhật tôi cũng nấu cơm."},{"q":"同乐，___吗？","options":["新","下班","星期","