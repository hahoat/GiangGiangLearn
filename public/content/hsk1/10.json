{"vocab":[{"han":"杯子","py":"bēi zi","pos":"danh từ","meaning":"cái cốc, cái ly","example":"请问，有杯子吗？","exampleVi":"Xin hỏi, có cốc không?"},{"han":"售货员","py":"shòu huò yuán","pos":"danh từ","meaning":"nhân viên bán hàng","example":"她是售货员。","exampleVi":"Cô ấy là nhân viên bán hàng."},{"han":"这边","py":"zhè biān","pos":"đại từ","meaning":"bên này","example":"杯子在这边。","exampleVi":"Cốc ở bên này."},{"han":"钱","py":"qián","pos":"danh từ","meaning":"tiền","example":"多少钱一个？","exampleVi":"Bao nhiêu tiền một cái?"},{"han":"块","py":"kuài","pos":"lượng từ","meaning":"đồng (tệ, văn nói)","example":"五块钱一个","exampleVi":"5 đồng một cái"},{"han":"元","py":"yuán","pos":"lượng từ","meaning":"tệ, đồng (văn viết)","example":"这件一百元。","exampleVi":"Cái này 100 tệ."},{"han":"角","py":"jiǎo","pos":"lượng từ","meaning":"hào (1/10 tệ)","example":"一元五角","exampleVi":"1 tệ 5 hào"},{"han":"这儿","py":"zhèr","pos":"đại từ","meaning":"ở đây","example":"这儿的苹果真便宜！","exampleVi":"Táo ở đây rẻ thật!"},{"han":"那儿","py":"nàr","pos":"đại từ","meaning":"ở đó, đằng kia","example":"男孩子的衣服在那儿。","exampleVi":"Quần áo con trai ở đằng kia."},{"han":"水果","py":"shuǐ guǒ","pos":"danh từ","meaning":"trái cây","example":"这儿的水果真不少！","exampleVi":"Trái cây ở đây nhiều thật!"},{"han":"苹果","py":"píng guǒ","pos":"danh từ","meaning":"quả táo","example":"我想买两斤苹果。","exampleVi":"Tôi muốn mua hai cân táo."},{"han":"少","py":"shǎo","pos":"tính từ","meaning":"ít","example":"这儿的人很少。","exampleVi":"Ở đây rất ít người."},{"han":"斤","py":"jīn","pos":"lượng từ","meaning":"cân (= 0,5 kg)","example":"苹果三块五一斤。","exampleVi":"Táo 3 đồng 5 một cân."},{"han":"便宜","py":"pián yi","pos":"tính từ","meaning":"rẻ","example":"这儿的衣服很便宜。","exampleVi":"Quần áo ở đây rất rẻ."},{"han":"贵","py":"guì","pos":"tính từ","meaning":"đắt","example":"好看，也不贵。","exampleVi":"Đẹp, cũng không đắt."},{"han":"商店","py":"shāng diàn","pos":"danh từ","meaning":"cửa hàng","example":"这家商店衣服真多！","exampleVi":"Cửa hàng này nhiều quần áo thật!"},{"han":"衣服","py":"yī fu","pos":"danh từ","meaning":"quần áo","example":"这件衣服怎么样？","exampleVi":"Cái áo này thế nào?"},{"han":"件","py":"jiàn","pos":"lượng từ","meaning":"cái, chiếc (quần áo, sự việc)","example":"买一件吧。","exampleVi":"Mua một cái đi."},{"han":"怎么样","py":"zěn me yàng","pos":"đại từ","meaning":"thế nào","example":"这件一百元，怎么样？","exampleVi":"Cái này 100 tệ, thế nào?"},{"han":"穿","py":"chuān","pos":"động từ","meaning":"mặc, mang","example":"小雪能穿。","exampleVi":"Tiểu Tuyết mặc được."},{"han":"女","py":"nǚ","pos":"tính từ","meaning":"nữ","example":"女孩子","exampleVi":"bé gái"},{"han":"男","py":"nán","pos":"tính từ","meaning":"nam","example":"男孩子","exampleVi":"bé trai"}],"grammar":[{"title":"Cách nói số tiền","desc":["Văn viết: 元 – 角 – 分; văn nói: 块 – 毛. Khi nói, đơn vị cuối thường được lược bỏ."],"formula":"… 元 … 角 = … 块 …","examples":[{"han":"一元五角 = 一块五","vi":"1 tệ 5 hào"},{"han":"二十一元四角 = 二十一块四","vi":"21 tệ 4 hào"}]},{"title":"Hỏi giá","desc":["Hỏi giá một đơn vị: 多少钱 + một + lượng từ? hoặc Danh từ + 多少钱 + một + lượng từ?"],"formula":"(Danh từ) + 多少钱 + 一 + Lượng từ？","examples":[{"han":"多少钱一个？","vi":"Bao nhiêu tiền một cái?"},{"han":"苹果三块五一斤。","vi":"Táo 3 đồng 5 một cân."}]},{"title":"这儿 / 那儿 và 这些 / 那些","desc":["这儿 (ở đây), 那儿 (ở đó) chỉ nơi chốn. 这些 (những … này), 那些 (những … kia) chỉ số nhiều."],"formula":"这儿 / 那儿 + 的 + Danh từ · 这些 / 那些 + (Danh từ)","examples":[{"han":"这儿的苹果真便宜！","vi":"Táo ở đây rẻ thật!"},{"han":"这些五块钱一个，那些十块钱一个。","vi":"Những cái này 5 đồng một cái, những cái kia 10 đồng một cái."}]},{"title":"Hỏi ý kiến với 怎么样","desc":["怎么样 đặt cuối câu để hỏi ý kiến, đánh giá của người nghe."],"formula":"… ，怎么样？","examples":[{"han":"这件一百元，怎么样？","vi":"Cái này 100 tệ, thế nào?"},{"han":"今天天气怎么样？","vi":"Hôm nay thời tiết thế nào?"}]}],"texts":[{"title":"Bài khóa 1","lines":[{"who":"王一雪","han":"请问，有杯子吗？","vi":"Xin hỏi, có cốc không?"},{"who":"售货员","han":"有，杯子在这边。","vi":"Có, cốc ở bên này."},{"who":"王一雪","han":"多少钱一个？","vi":"Bao nhiêu tiền một cái?"},{"who":"售货员","han":"这些五块钱一个，那些十块钱一个。","vi":"Những cái này 5 đồng một cái, những cái kia 10 đồng một cái."},{"who":"王一雪","han":"我买这个吧。","vi":"Tôi mua cái này nhé."}]},{"title":"Bài khóa 2","lines":[{"who":"刘明","han":"这儿的水果真不少！","vi":"Trái cây ở đây nhiều thật!"},{"who":"售货员","han":"您想买什么？","vi":"Anh muốn mua gì?"},{"who":"刘明","han":"我想买两斤苹果。","vi":"Tôi muốn mua hai cân táo."},{"who":"售货员","han":"苹果三块五一斤。这些七块二，七块钱吧。","vi":"Táo 3 đồng 5 một cân. Chỗ này 7 đồng 2, lấy 7 đồng thôi."},{"who":"刘明","han":"好的，这儿的苹果真便宜！","vi":"Được, táo ở đây rẻ thật!"}]},{"title":"Bài khóa 3","lines":[{"who":"王一雪","han":"这家商店衣服真多！这件一百元，怎么样？","vi":"Cửa hàng này nhiều quần áo thật! Cái này 100 tệ, thế nào anh?"},{"who":"刘明","han":"好看，也不贵。小雪能穿，买一件吧。","vi":"Đẹp, cũng không đắt. Tiểu Tuyết mặc được, mua một cái đi."},{"who":"王一雪","han":"好的。小明能穿吗？","vi":"Được. Tiểu Minh mặc được không?"},{"who":"售货员","han":"不能。这些是女孩子穿的衣服，男孩子的衣服在那儿。","vi":"Không được ạ. Đây là quần áo con gái, quần áo con trai ở đằng kia."}]}],"id":10,"title":"这儿的苹果真便宜","py":"Zhèr de píng guǒ zhēn pián yi","vi":"Táo ở đây rẻ thật","goal":"Mua bán: hỏi giá, nói số tiền (元/块, 角), đơn vị cân 斤; dùng 这儿/那儿, 这些/那些; hỏi ý kiến với 怎么样.","decks":["bai-10"],"practice":{"choice":[{"q":"请问，有___吗？","options":["杯子","件","斤","块"],"answer":0,"vi":"Xin hỏi, có cốc không?"},{"q":"杯子在___。","options":["块","怎么样","这边","多少"],"answer":2,"vi":"Cốc ở bên này."},{"q":"多少___一个？","options":["贵","斤","件","钱"],"answer":3,"vi":"Bao nhiêu tiền một cái?"},{"q":"这些五___钱一个。","options":["块","件","只","斤"],"answer":0,"vi":"Những cái này 5 đồng một cái."},{"q":"我___这个吧。","options":["少","买","贵","便宜"],"answer":1,"vi":"Tôi mua cái này nhé."},{"q":"这儿的___真不少！","options":["水果","块","钱","斤"],"answer":0,"vi":"Trái cây ở đây nhiều thật!"},{"q":"我想买两___苹果。","options":["件","斤","本","只"],"answer":1,"vi":"Tôi muốn mua hai cân táo."},{"q":"___三块五一斤。","options":["衣服","钱","杯子","苹果"],"answer":3,"vi":"Táo 3 đồng 5 một cân."},{"q":"这儿的苹果真___！","options":["便宜","衣服","斤","件"],"answer":0,"vi":"Táo ở đây rẻ thật!"},{"q":"这家___衣服真多！","options":["斤","件","商店","块"],"answer":2,"vi":"Cửa hàng này nhiều quần áo thật!"},{"q":"这件一百元，___？","options":["这边","多少","怎么样","哪儿"],"answer":2,"vi":"Cái này 100 tệ, thế nào?"},{"q":"好看，也不___。","options":["斤","件","块","贵"],"answer":3,"vi":"Đẹp, cũng không đắt."},{"q":"小雪能穿，买一___吧。","options":["只","件","本","斤"],"answer":1,"vi":"Tiểu Tuyết mặc được, mua một cái đi."},{"q":"这些是女孩子___的衣服。","options":["穿","贵","斤","块"],"answer":0,"vi":"Đây là quần áo con gái mặc."},{"q":"男孩子的衣服在___。","options":["多少","怎么样","那儿","斤"],"answer":2,"vi":"Quần áo con trai ở đằng kia."}],"order":[{"words":["请问","杯子","吗","有"],"answer":["请问","有","杯子","吗"],"end":"，？","vi":"Xin hỏi, có cốc không?"},{"words":["一","多少","钱","个"],"answer":["多少","钱","一","个"],"end":"？","vi":"Bao nhiêu tiền một cái?"},{"words":["买","我","个","这","吧"],"answer":["我","买","这","个","吧"],"end":"。","vi":"Tôi mua cái này nhé."},{"words":["斤","买","我","苹果","两","想"],"answer":["我","想","买","两","斤","苹果"],"end":"。","vi":"Tôi muốn mua hai cân táo."},{"words":["的","这儿","便宜","苹果","真"],"answer":["这儿","的","苹果","真","便宜"],"end":"！","vi":"Táo ở đây rẻ thật!"},{"words":["一百","件","元","这","怎么样"],"answer":["这","件","一百","元","怎么样"],"end":"，？","vi":"Cái này 100 tệ, thế nào?"},{"words":["买","件","小雪","能","吧","穿","一"],"answer":["小雪","能","穿","买","一","件","吧"],"end":"，。","vi":"Tiểu Tuyết mặc được, mua một cái đi."},{"words":["衣服","那儿","男孩子","的","在"],"answer":["男孩子","的","衣服","在","那儿"],"end":"。","vi":"Quần áo con trai ở đằng kia."},{"words":["买","想","我","个","杯子","一"],"answer":["我","想","买","一","个","杯子"],"end":"。","vi":"Tôi muốn mua một cái cốc."},{"words":["水果","我","吃","喜欢"],"answer":["我","喜欢","吃","水果"],"end":"。","vi":"Tôi thích ăn trái cây."},{"words":["钱","块","有","二十","我"],"answer":["我","有","二十","块","钱"],"end":"。","vi":"Tôi có 20 đồng."},{"words":["她","的","衣服","真","漂亮","穿"],"answer":["她","穿","的","衣服","真","漂亮"],"end":"。","vi":"Quần áo cô ấy mặc thật đẹp."},{"words":["买","苹果","我","斤","三"],"answer":["我","买","三","斤","苹果"],"end":"。","vi":"Tôi mua ba cân táo."},{"words":["一百","衣服","件","这"