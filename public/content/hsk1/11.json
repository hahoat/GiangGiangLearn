{"vocab":[{"han":"时候","py":"shí hou","pos":"danh từ","meaning":"lúc, khi","example":"你什么时候能到？","exampleVi":"Khi nào bạn đến được?"},{"han":"知道","py":"zhī dào","pos":"động từ","meaning":"biết","example":"我不知道。","exampleVi":"Tôi không biết."},{"han":"正在","py":"zhèng zài","pos":"phó từ","meaning":"đang","example":"我正在看电视。","exampleVi":"Tôi đang xem ti vi."},{"han":"在","py":"zài","pos":"phó từ","meaning":"đang","example":"学生们在上课呢。","exampleVi":"Các học sinh đang học."},{"han":"找","py":"zhǎo","pos":"động từ","meaning":"tìm","example":"我正在找呢。","exampleVi":"Tôi đang tìm đây."},{"han":"开车","py":"kāi chē","pos":"động từ","meaning":"lái xe","example":"你开车没开车？","exampleVi":"Bạn có lái xe không?"},{"han":"车","py":"chē","pos":"danh từ","meaning":"xe","example":"我坐车呢。","exampleVi":"Tôi đang đi xe."},{"han":"后边","py":"hòu bian","pos":"danh từ","meaning":"phía sau","example":"饭店在超市后边。","exampleVi":"Nhà hàng ở phía sau siêu thị."},{"han":"读","py":"dú","pos":"động từ","meaning":"học (ở trường); đọc","example":"你还在读大学吗？","exampleVi":"Bạn vẫn đang học đại học à?"},{"han":"大学","py":"dà xué","pos":"danh từ","meaning":"trường đại học","example":"我读大学呢。","exampleVi":"Tôi đang học đại học."},{"han":"大学生","py":"dà xué shēng","pos":"danh từ","meaning":"sinh viên","example":"我还是大学生。","exampleVi":"Tôi vẫn là sinh viên."},{"han":"学","py":"xué","pos":"động từ","meaning":"học","example":"我学医。","exampleVi":"Tôi học y."},{"han":"医","py":"yī","pos":"danh từ","meaning":"y học","example":"我学医，我们的课很多。","exampleVi":"Tôi học y, chúng tôi có nhiều tiết học."},{"han":"起床","py":"qǐ chuáng","pos":"động từ","meaning":"thức dậy","example":"弟弟起床没起床？","exampleVi":"Em trai dậy chưa?"},{"han":"睡觉","py":"shuì jiào","pos":"động từ","meaning":"ngủ","example":"他还在睡觉。","exampleVi":"Nó vẫn đang ngủ."},{"han":"睡","py":"shuì","pos":"động từ","meaning":"ngủ","example":"还睡呢？","exampleVi":"Vẫn còn ngủ à?"},{"han":"哪里","py":"nǎ lǐ","pos":"đại từ","meaning":"ở đâu","example":"去哪里？","exampleVi":"Đi đâu?"},{"han":"问","py":"wèn","pos":"động từ","meaning":"hỏi","example":"我昨天问他。","exampleVi":"Hôm qua tôi đã hỏi nó."},{"han":"对","py":"duì","pos":"giới từ","meaning":"với, đối với","example":"他对我说，他不去。","exampleVi":"Nó nói với tôi là nó không đi."},{"han":"说","py":"shuō","pos":"động từ","meaning":"nói","example":"你说什么？","exampleVi":"Bạn nói gì?"},{"han":"要","py":"yào","pos":"động từ năng nguyện","meaning":"muốn, sẽ, định","example":"他今天要和小朋友玩。","exampleVi":"Hôm nay nó muốn chơi với các bạn nhỏ."},{"han":"小朋友","py":"xiǎo péng you","pos":"danh từ","meaning":"bạn nhỏ, trẻ em","example":"我和小朋友们玩。","exampleVi":"Tôi chơi với các bạn nhỏ."}],"grammar":[{"title":"Câu hỏi chính phản","desc":["Đặt dạng khẳng định và phủ định của động từ / tính từ cạnh nhau để hỏi, không dùng thêm 吗. Với hành động đã xảy ra dùng V + 没 + V."],"formula":"V / Adj + 不 + V / Adj？ · V + 没 + V？","examples":[{"han":"这件衣服好看不好看？","vi":"Cái áo này có đẹp không?"},{"han":"昨天你去没去书店？","vi":"Hôm qua bạn có đi hiệu sách không?"}]},{"title":"Đang làm gì: 在 / 正在 … 呢","desc":["在, 正在 đứng trước động từ, 呢 ở cuối câu, cho biết hành động đang diễn ra. Có thể dùng một trong hai hoặc cả hai."],"formula":"Chủ ngữ + (正)在 + Động từ + (呢)","examples":[{"han":"学生们正在上课呢。","vi":"Các học sinh đang học."},{"han":"A：你在做什么呢？ B：我正在看电视。","vi":"A: Bạn đang làm gì thế? B: Tôi đang xem ti vi."}]},{"title":"Động từ năng nguyện 要","desc":["要 + động từ: muốn, định, sắp làm gì (ý muốn mạnh hoặc kế hoạch đã định)."],"formula":"Chủ ngữ + 要 + Động từ","examples":[{"han":"妈妈要去超市。","vi":"Mẹ định đi siêu thị."},{"han":"白家月要在家里学中文。","vi":"Bạch Gia Nguyệt sẽ học tiếng Trung ở nhà."}]},{"title":"Vị trí: A 在 B 的 … 边","desc":[],"formula":"A + 在 + B + 前边 / 后边 / 外边 …","examples":[{"han":"饭店在超市后边。","vi":"Nhà hàng ở phía sau siêu thị."},{"han":"医院在哪儿？","vi":"Bệnh viện ở đâu?"}]}],"texts":[{"title":"Bài khóa 1","lines":[{"who":"王一飞","han":"喂，李文，你什么时候能到饭店？","vi":"A lô, Lý Văn, khi nào em đến được nhà hàng?"},{"who":"李文","han":"还不知道，正在找呢。它是不是在超市后边？","vi":"Em chưa biết nữa, đang tìm đây. Có phải nó ở phía sau siêu thị không ạ?"},{"who":"王一飞","han":"是的。你开车没开车？","vi":"Đúng rồi. Em có lái xe không?"},{"who":"李文","han":"我没开车，坐车呢。","vi":"Em không lái xe, em đang đi xe ạ."}]},{"title":"Bài khóa 2","lines":[{"who":"安妮","han":"你还在读大学吗？","vi":"Bạn vẫn đang học đại học à?"},{"who":"陈天中","han":"对，我读大学呢，还是大学生。","vi":"Đúng vậy, mình đang học đại học, vẫn là sinh viên."},{"who":"安妮","han":"你们学习忙不忙？","vi":"Các bạn học có bận không?"},{"who":"陈天中","han":"非常忙，我学医，我们的课很多。","vi":"Rất bận, mình học y, tụi mình có rất nhiều tiết."}]},{"title":"Bài khóa 3","lines":[{"who":"刘明","han":"弟弟起床没起床呢？","vi":"Em trai dậy chưa?"},{"who":"刘小雪","han":"没起床呢，还在睡觉。","vi":"Chưa dậy ạ, vẫn đang ngủ."},{"who":"刘明","han":"还睡呢？他今天去不去那里？","vi":"Vẫn còn ngủ à? Hôm nay nó có đến đó không?"},{"who":"刘小雪","han":"去哪里？","vi":"Đến đâu ạ?"},{"who":"刘明","han":"去超市。","vi":"Đến siêu thị."},{"who":"刘小雪","han":"我昨天问他，他对我说，他不去，他今天要和小朋友玩。","vi":"Hôm qua con hỏi rồi, em nói với con là em không đi, hôm nay em muốn chơi với các bạn nhỏ."}]}],"id":11,"title":"我读大学呢","py":"Wǒ dú dà xué ne","vi":"Tôi đang học đại học","goal":"Hỏi bằng câu chính phản (V不V / V没V); nói hành động đang diễn ra với 在/正在…呢; nói ý định với 要; hỏi thời điểm với 什么时候.","decks":["bai-11"],"practice":{"choice":[{"q":"你什么___能到饭店？","options":["知道","正在","车","时候"],"answer":3,"vi":"Khi nào bạn có thể đến nhà hàng?"},{"q":"我还不___。","options":["大学","时候","车","知道"],"answer":3,"vi":"Tôi vẫn chưa biết."},{"q":"我正在___呢。","options":["车","找","大学","医"],"answer":1,"vi":"Tôi đang tìm đây."},{"q":"它是不是在超市___？","options":["车","后边","时候","大学"],"answer":1,"vi":"Có phải nó ở phía sau siêu thị không?"},{"q":"你开车___开车？","options":["很","没","吗","也"],"answer":1,"vi":"Bạn có lái xe không?"},{"q":"我没开车，___车呢。","options":["坐","读","医","知道"],"answer":0,"vi":"Tôi không lái xe, đang đi xe."},{"q":"你还在读___吗？","options":["医","时候","车","大学"],"answer":3,"vi":"Bạn vẫn đang học đại học à?"},{"q":"我还是___。","options":["时候","大学生","医","大学"],"answer":1,"vi":"Tôi vẫn là sinh viên."},{"q":"我学___，我们的课很多。","options":["时候","找","医","车"],"answer":2,"vi":"Tôi học y, chúng tôi có rất nhiều tiết học."},{"q":"___起床没起床？","options":["弟弟","时候","医","大学"],"answer":0,"vi":"Em trai dậy chưa?"},{"q":"他还在___。","options":["时候","医","大学","睡觉"],"answer":3,"vi":"Nó vẫn đang ngủ."},{"q":"他今天去不去___？","options":["那里","时候","医","知道"],"answer":0,"vi":"Hôm nay nó có đến đó không?"},{"q":"我昨天___他。","options":["问","时候","车","医"],"answer":0,"vi":"Hôm qua tôi đã hỏi nó."},{"q":"他___我说，他不去。","options":["对","知道","时候","在"],"answer":0,"vi":"Nó nói với tôi là nó không đi."},{"q":"他今天___和小朋友玩。","options":["医","时候","车","要"],"answer":3,"vi":"Hôm nay nó muốn chơi với các bạn nhỏ."}],"order":[{"words":["能","什么","你","到","时候","饭店"],"answer":["你","什么","时候","能","到","饭店"],"end":"？","vi":"Khi nào bạn có thể đến nhà hàng?"},{"words":["正在","找","呢","我"],"answer":["我","正在","找","呢"],"end":"。","vi":"Tôi đang tìm đây."},{"words":["没","开车","你","开车"],"answer":["你","开车","没","开车"],"end":"？","vi":"Bạn có lái xe không?"},{"words":["还","吗","在","大学","你","读"],"answer":["你","还","在","读","大学","吗"],"end":"？","vi":"Bạn vẫn đang học đại học à?"},{"words":["课","很","医","的","多","我","学","我们"],"answer":["我","学","医","我们","的","课","很","多"],"end":"，。","vi":"Tôi học y, chúng tôi có rất nhiều tiết học."},{"words":["还","在","他","睡觉"],"answer":["他","还","在","睡觉"],"end":"。","vi":"Nó vẫn đang ngủ."},{"words":["他","我","昨天","问"],"answer":["我","昨天","问","他"],"end":"。","vi":"Hôm qua tôi đã hỏi nó."},{"words":["小朋友","和","今天","他","玩","要"],"answer":["他","今天","要","和","小朋友","玩"],"end":"。","vi":"Hôm nay nó muốn chơi với các bạn nhỏ."},{"words":["什么","你","做","呢","在"],"answer":["你","在","做","什么","呢"],"end":"？","vi":"Bạn đang làm gì thế?"},{"words":["去","时候","什么","中国","你"],"answer":["你","什么","时候","去","中国"],"end":"？","vi":"Khi nào bạn đi Trung Quốc?"},{"words":["衣服","这","好看","好看","不","件"],"answer":["这","件","衣服","好看","不","好看"],"end":"？","vi":"Cái áo này có đẹp không?"},{"words":["我","会","开车","爸爸"],"answer":["我","爸爸","会","开车"],"end":"。","vi":"Bố tôi biết lái xe."},{"words":["七","起床","早上","点","我"],"answer":["我","早上","七","点","起床"],"end":"。","vi":"Tôi dậy lúc 7 giờ sáng."},{"words":["超市","去","要","妈妈"],"answer":["妈妈","要","去","超市"],"end":"。","vi":"Mẹ định đi siêu thị."},{"words":["没","去","书店","去","你"],"answer":["你","去","没","去","书店"],"end":"？","vi":"Bạn đã đến hiệu sách chưa?"}],"fill":[{"q":"___正在上课呢。","answer":"学生们","hint":"Các học sinh đang học."},{"q":"你在做___呢？","answer":"什么","hint":"Bạn đang làm gì thế?"},{"q":"我正在___电视。","answer":"看","hint":"Tôi đang xem ti vi."},{"q":"你什么___去中国？","answer":"时候","hint":"Khi nào bạn đi Trung Quốc?"},{"q":"我不___他在哪儿。","answer":"知道","hint":"Tôi không biết anh ấy ở đâu."},{"q":"这件___好看不好看？","answer":"衣服","hint":"Cái áo này có đẹp không?"},{"q":"我去学校___你。","answer":"找","hint":"Tôi đến trường tìm bạn."},{"q":"我爸爸会___。","answer":"开车","hint":"Bố tôi biết lái xe."},{"q":"她是___。","answer":"大学生","hint":"Cô ấy là sinh viên đại học."},{"q":"我早上七点___。","answer":"起床","hint":"Tôi dậy lúc 7 giờ sáng."},{"q":"你晚上几点___？","answer":"睡觉","hint":"Buổi tối mấy giờ bạn ngủ?"},{"q":"妈妈___去超市。","answer":"要","hint":"Mẹ định đi siêu thị."},{"q":"医院在超市___。","answer":"后边","hint":"Bệnh viện ở phía sau siêu thị."},{"q":"你去___去书店？","answer":"没","hint":"Bạn đã đến hiệu sách chưa?"},{"q":"白家月要在___学中文。","answer":"家里","hint":"Bạch Gia Nguyệt sẽ học tiếng Trung ở nhà."}]}}