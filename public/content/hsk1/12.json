{"vocab":[{"han":"天气","py":"tiān qì","pos":"danh từ","meaning":"thời tiết","example":"今天天气怎么样？","exampleVi":"Hôm nay thời tiết thế nào?"},{"han":"这里","py":"zhè lǐ","pos":"đại từ","meaning":"ở đây","example":"这里的天不太好。","exampleVi":"Thời tiết ở đây không tốt lắm."},{"han":"天","py":"tiān","pos":"danh từ","meaning":"trời, thời tiết","example":"今天天很好。","exampleVi":"Hôm nay trời rất đẹp."},{"han":"下雨","py":"xià yǔ","pos":"động từ","meaning":"mưa","example":"下雨了。","exampleVi":"Trời mưa rồi."},{"han":"雨","py":"yǔ","pos":"danh từ","meaning":"mưa","example":"雨大吗？","exampleVi":"Mưa to không?"},{"han":"有点儿","py":"yǒu diǎnr","pos":"phó từ","meaning":"hơi, có chút (không như ý)","example":"雨有点儿大。","exampleVi":"Mưa hơi to."},{"han":"觉得","py":"jué de","pos":"động từ","meaning":"cảm thấy, thấy","example":"我觉得很冷。","exampleVi":"Tôi thấy rất lạnh."},{"han":"冷","py":"lěng","pos":"tính từ","meaning":"lạnh","example":"太冷了！","exampleVi":"Lạnh quá!"},{"han":"下","py":"xià","pos":"động từ","meaning":"rơi (mưa, tuyết)","example":"昨天下雪了。","exampleVi":"Hôm qua tuyết rơi."},{"han":"雪","py":"xuě","pos":"danh từ","meaning":"tuyết","example":"北京下雪了。","exampleVi":"Bắc Kinh có tuyết rồi."},{"han":"热","py":"rè","pos":"tính từ","meaning":"nóng","example":"今天很热。","exampleVi":"Hôm nay rất nóng."},{"han":"来","py":"lái","pos":"động từ","meaning":"đến, tới","example":"你昨天没来公司。","exampleVi":"Hôm qua bạn không đến công ty."},{"han":"公司","py":"gōng sī","pos":"danh từ","meaning":"công ty","example":"我去公司上班。","exampleVi":"Tôi đến công ty làm việc."},{"han":"生病","py":"shēng bìng","pos":"động từ","meaning":"bị ốm","example":"你生病了？","exampleVi":"Bạn bị ốm à?"},{"han":"看病","py":"kàn bìng","pos":"động từ","meaning":"đi khám bệnh","example":"我去医院看病了。","exampleVi":"Tôi đi bệnh viện khám bệnh."},{"han":"病","py":"bìng","pos":"động từ","meaning":"ốm, bệnh","example":"医生，我病了。","exampleVi":"Bác sĩ, tôi bị ốm."},{"han":"一点儿","py":"yì diǎnr","pos":"số lượng từ","meaning":"một chút, một ít","example":"吃一点儿药。","exampleVi":"Uống một chút thuốc."},{"han":"药","py":"yào","pos":"danh từ","meaning":"thuốc","example":"你吃药了吗？","exampleVi":"Bạn uống thuốc chưa?"},{"han":"回","py":"huí","pos":"động từ","meaning":"về, trở về","example":"你什么时候回家？","exampleVi":"Khi nào bạn về nhà?"},{"han":"再","py":"zài","pos":"phó từ","meaning":"rồi mới, sau đó","example":"回家后再喝些热水。","exampleVi":"Về nhà rồi uống thêm ít nước nóng."},{"han":"喝","py":"hē","pos":"động từ","meaning":"uống","example":"请喝水。","exampleVi":"Mời uống nước."},{"han":"水","py":"shuǐ","pos":"danh từ","meaning":"nước","example":"我喝一点儿水。","exampleVi":"Tôi uống một chút nước."}],"grammar":[{"title":"Câu không chủ ngữ","desc":["Câu chỉ có vị ngữ, thường nói về thời tiết, hiện tượng, lời chào, lời xin lỗi."],"formula":"Động từ / Tính từ + (了)","examples":[{"han":"下雨了。","vi":"Trời mưa rồi."},{"han":"对不起！—— 没关系！","vi":"Xin lỗi! – Không sao!"}]},{"title":"Trợ từ ngữ khí 了 (1): sự thay đổi","desc":["了 ở cuối câu cho biết tình huống mới xuất hiện hoặc đã thay đổi. Hỏi: … 了吗？ Phủ định: 没 … 呢."],"formula":"Câu + 了","examples":[{"han":"十二点了，吃午饭吧。","vi":"12 giờ rồi, ăn trưa thôi."},{"han":"A：弟弟起床了吗？ B：没起床呢。","vi":"A: Em trai dậy chưa? B: Chưa dậy."}]},{"title":"太 … 了","desc":["Diễn tả mức độ rất cao, dùng để cảm thán (khen hoặc chê)."],"formula":"太 + Tính từ + 了","examples":[{"han":"太冷了！","vi":"Lạnh quá!"},{"han":"我们今天太高兴了！","vi":"Hôm nay chúng tôi vui quá!"}]},{"title":"有点儿 + tính từ","desc":["有点儿 đặt trước tính từ: \"hơi …\", thường mang ý không hài lòng. Khác với 一点儿 (một chút) đứng sau động từ."],"formula":"有点儿 + Tính từ · Động từ + 一点儿 + Danh từ","examples":[{"han":"雨有点儿大。","vi":"Mưa hơi to."},{"han":"吃一点儿药。","vi":"Uống một chút thuốc."}]},{"title":"… 后再 …: sau khi … rồi mới …","desc":[],"formula":"Hành động 1 + 后 + 再 + Hành động 2","examples":[{"han":"回家后再喝些热水。","vi":"Về nhà rồi uống thêm ít nước nóng."}]}],"texts":[{"title":"Bài khóa 1","lines":[{"who":"王一飞","han":"今天天气怎么样？","vi":"Hôm nay thời tiết thế nào ạ?"},{"who":"王一雪","han":"这里的天不太好，下雨了。","vi":"Trời ở đây không đẹp lắm, mưa rồi."},{"who":"王一飞","han":"雨大吗？","vi":"Mưa to không ạ?"},{"who":"王一雪","han":"有点儿大，我觉得很冷。","vi":"Hơi to, chị thấy rất lạnh."}]},{"title":"Bài khóa 2","lines":[{"who":"王一雪","han":"昨天下雪了。","vi":"Hôm qua tuyết rơi."},{"who":"杨同乐","han":"是的，太冷了。","vi":"Vâng, lạnh quá."},{"who":"王一雪","han":"你昨天没来公司，生病了？","vi":"Hôm qua em không đến công ty, em bị ốm à?"},{"who":"杨同乐","han":"对，我昨天去医院看病了。","vi":"Vâng, hôm qua em đi bệnh viện khám bệnh."}]},{"title":"Bài khóa 3","lines":[{"who":"杨同乐","han":"医生，我病了。","vi":"Bác sĩ, tôi bị ốm rồi."},{"who":"胡医生","han":"我看看。你觉得怎么样？","vi":"Để tôi xem. Anh thấy thế nào?"},{"who":"杨同乐","han":"我很冷。","vi":"Tôi thấy rất lạnh."},{"who":"胡医生","han":"好的，吃一点儿药，今天休息半天吧。","vi":"Được, uống một chút thuốc, hôm nay nghỉ nửa ngày nhé."},{"who":"杨同乐","han":"好的。","vi":"Vâng."},{"who":"胡医生","han":"回家后再喝些热水。","vi":"Về nhà rồi uống thêm ít nước nóng."}]}],"id":12,"title":"昨天下雪了","py":"Zuó tiān xià xuě le","vi":"Hôm qua tuyết rơi","goal":"Nói về thời tiết và sức khỏe; dùng câu không chủ ngữ (下雨了), trợ từ 了 chỉ sự thay đổi, 太…了, 有点儿, …后再….","decks":["bai-12"],"practice":{"choice":[{"q":"今天___怎么样？","options":["公司","雪","药","天气"],"answer":3,"vi":"Hôm nay thời tiết thế nào?"},{"q":"___的天不太好。","options":["再","有点儿","这里","一点儿"],"answer":2,"vi":"Thời tiết ở đây không tốt lắm."},{"q":"___了。","options":["公司","下雨","药","觉得"],"answer":1,"vi":"Trời mưa rồi."},{"q":"雨___大。","options":["再","一点儿","回","有点儿"],"answer":3,"vi":"Mưa hơi to."},{"q":"我___很冷。","options":["药","觉得","雪","公司"],"answer":1,"vi":"Tôi thấy rất lạnh."},{"q":"昨天下___了。","options":["天气","药","公司","雪"],"answer":3,"vi":"Hôm qua tuyết rơi."},{"q":"是的，___冷了。","options":["回","太","再","来"],"answer":1,"vi":"Đúng vậy, lạnh quá."},{"q":"你昨天没___公司。","options":["雪","来","冷","热"],"answer":1,"vi":"Hôm qua bạn không đến công ty."},{"q":"我昨天去医院___了。","options":["雪","公司","天气","看病"],"answer":3,"vi":"Hôm qua tôi đi bệnh viện khám bệnh."},{"q":"医生，我___了。","options":["雪","病","天气","药"],"answer":1,"vi":"Bác sĩ, tôi bị ốm 